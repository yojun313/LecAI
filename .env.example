# ===============================
# Custom LLM server settings
# ===============================
# OpenAI-compatible API base URL
PPT_LLM_URL=http://localhost:8000/v1

# ---- 음성 인식(STT) ----
# 사용자가 설정 화면에서 custom(매니저 서버 GPU Whisper, 무료) / openai(각자 OpenAI 키) 를 고른다. 미선택 시 기본값:
STT_DEFAULT_PROVIDER=custom
# custom 서버 (매니저)
AUDIO_LLM_URL=https://manager.knpu.re.kr/api/analysis/whisper
# 실시간 진행률(NDJSON 스트림) 엔드포인트. 비우면 위 주소 + /stream 을 시도하고 없으면 일괄 방식으로 자동 전환
AUDIO_LLM_STREAM_URL=
# 매니저 앱 /token 값 (비우면 CUSTOM_TOKEN 사용)
AUDIO_LLM_TOKEN=
# 매니저 진행상황 서버 (STT 진행 메시지 구독용, 선택)
AUDIO_PROGRESS_URL=https://manager.knpu.re.kr/progress
# openai 모델
OPENAI_STT_MODEL=gpt-transcribe

# Authorization token for custom server
CUSTOM_TOKEN=your_custom_token_here

SECRET_KEY=your_secret_key_here
MAIL_SENDER=your_mail_sender_here
MAIL_PASSWORD=your_mail_password_here
   
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=lec-ai
MONGO_USERNAME=admin
MONGO_PASSWORD=your_mongo_password_here

# 결과물 PDF(result.pdf) 생성 여부 (기본 false)
GENERATE_PDF=false
